{
  "name": "wave-walker-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wave Walker engine — one modular source compiled by cross-workflow for Claude Workflow and the Codex SDK",
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning build.js",
    "verify": "node --disable-warning=ExperimentalWarning verify.js",
    "equivalence:headless": "node headless-equivalence.js",
    "production-walk": "node production-walk.js",
    "activate:legacy": "node activate.js legacy",
    "activate:candidate": "node activate.js candidate",
    "pretest": "npm run verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "cross-workflow": "file:vendor/cross-workflow-0.2.0.tgz"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "acorn": "^8.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  }
}
