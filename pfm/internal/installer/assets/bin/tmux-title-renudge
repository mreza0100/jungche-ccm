#!/usr/bin/env bash
# Re-emit the outer-terminal (OSC) title on every live tmux server.
#
# Why: VS Code Remote tabs use ${sequence} for their label; a window reload
# revives persistent terminals with an EMPTY sequence title, and tmux re-sends
# the escape only when the COMPUTED title changes — set-titles-string strips the
# one part that changes (the status glyph), so an unchanged label like "P:PFM"
# is never re-offered and the tab falls back to "tmux". Nudging set-titles-string
# away and back forces two re-emits and ends at the original value.
#
# Idempotent, invisible (final title identical), safe to run at any time.
# Silent on success so the systemd timer doesn't flood the journal.
#
# A server with `set-titles off` (host-owned titles, or pfm's tmux.titles.enabled=false) emits
# no OSC title at all, so a nudge there can accomplish nothing: such servers are skipped, and a
# run where EVERY live server is host-owned exits 3 and says so — never a silent success.
set -u
dir="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"  # tmux keeps sockets under <tmpdir>/tmux-<uid>/
[ -d "$dir" ] || exit 0
failed=0
nudged=0
hostowned=0
for s in "$dir"/*; do
  [ -S "$s" ] || continue
  cur=$(tmux -S "$s" show -gv set-titles-string 2>/dev/null) || continue  # dead socket: skip
  if [ "$(tmux -S "$s" show -gv set-titles 2>/dev/null)" != "on" ]; then
    hostowned=$((hostowned + 1))
    continue
  fi
  nudged=$((nudged + 1))
  if ! { tmux -S "$s" set -g set-titles-string "${cur} " 2>/dev/null &&
         tmux -S "$s" set -g set-titles-string "$cur" 2>/dev/null; }; then
    echo "tmux-title-renudge: nudge failed on $s" >&2
    failed=1
  fi
done
if [ "$failed" -eq 0 ] && [ "$nudged" -eq 0 ] && [ "$hostowned" -gt 0 ]; then
  echo "tmux-title-renudge: nothing to nudge — all $hostowned live servers have set-titles off (host-owned titles)" >&2
  exit 3
fi
exit "$failed"
