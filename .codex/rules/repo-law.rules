# Professor repo law at the execpolicy layer — loads for EVERY trusted Codex
# session in this repo (agent lanes AND interactive use; the law binds both).
# Mirrors the CLAUDE.md infra law. Validate after every edit:
#
#   codex execpolicy check --pretty --rules .codex/rules/repo-law.rules -- git status
#
# The FILENAME is arbitrary — Codex discovers every *.rules file under
# .codex/rules/. Name it after the law, not after the lane that motivated it.
#
# WHAT THIS LAYER IS FOR: the few commands where a wrong call is expensive and a
# prose reminder is not enough. It is a door lock, not a policy document. Keep it
# SHORT. Every rule here has to be maintained against a real CLI's real argv, and
# a rule that can never fire is worse than no rule — it reads as protection while
# protecting nothing. Write the rule, then prove it with `execpolicy check`.
#
# A rejection quoting its justification is THE LAW WORKING. Never rephrase, wrap,
# or shell-trick around one; a genuinely-required rejected command is an
# escalation to the founder, not a puzzle to route around.

# ─── The git monopoly, pinned rather than promised ───────────────────────────
#
# The blueprint ships these COMMENTED OUT, because in the source pipeline git
# binds as prose law and that has held. THIS repo enables them, and the reason is
# specific: this repo is PUBLIC. A push here is world-visible and cannot be
# unpublished, and the leak gate that guards it lives in a git hook that a Codex
# session has no reason to know about. Prose is enough where a mistake is
# recoverable; here it is not. gitter (a Claude agent) is deliberately absent
# from .codex/agents/ for the same reason — the compiler's never-register set
# enforces it.
#
# What this buys and what it costs: a Codex session in this repo cannot commit,
# tag, or push — including in a legitimate recovery path. That is the intended
# trade. Read-only git (status/log/diff/show/rev-parse) stays open.

prefix_rule(
    pattern = ["git", "commit"],
    decision = "forbidden",
    justification = "Only gitter commits (repo law). Report the diff and request a gitter dispatch through /git commit.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Only gitter pushes, and only on an explicit in-turn publish request (repo law). This repo is public — a push cannot be unpublished.",
)

prefix_rule(
    pattern = ["git", "tag"],
    decision = "forbidden",
    justification = "Release tags are gitter's, through /pcm:release. VERSION, CHANGELOG.md, and releases/vX.Y.Z.md must agree before a tag exists.",
)

# ─── Publication surface beyond git ──────────────────────────────────────────

prefix_rule(
    pattern = ["gh", "release"],
    decision = "forbidden",
    justification = "Publishing a release is /pcm:release's sequence, executed by gitter on an explicit founder request.",
)
