# Remote harvester configuration. Copy to `.env.remote` and fill in — `.env.remote` is gitignored.
#
#   cp .env.remote.example .env.remote
#   docker compose -f compose.remote.yaml --env-file .env.remote up -d --build

# The externally visible origin, WITHOUT a trailing slash. Must match what you type into the client
# exactly — OAuth protected-resource metadata is compared verbatim, and a mismatch shows up only as
# "couldn't reach the MCP server".
#   Tailscale Funnel:  https://<node>.<tailnet>.ts.net
HARVESTER_PUBLIC_URL=https://CHANGE-ME.ts.net

# Operator passphrase — what you type on the consent screen when Claude asks to connect.
# Setting this (or the static token below) turns authentication ON. Leave BOTH empty only for a
# loopback-only instance; the server refuses to bind an unauthenticated port to a public address.
# Generate one:  python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
HARVESTER_AUTH_PASSPHRASE=

# Optional fixed bearer token for non-browser clients (curl, Claude Code, or a claude.ai account
# with the request-header beta). Sent as `Authorization: Bearer <token>`.
# Generate one:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HARVESTER_STATIC_TOKEN=

# Optional. Polite-pool contact for scholarly APIs (Crossref / Unpaywall / NCBI) — better rate
# limits, never required. Empty means no contact is sent.
HARVESTER_CONTACT_EMAIL=

# Seconds before a cached web page/PDF/Office/CSV/JSON/TXT artifact is considered stale and
# re-fetched. Images and archive members never expire, whatever this is set to. 0 disables expiry.
#HARVESTER_CACHE_TTL=86400

# Optional. Name (or path) of the on-disk cache directory. A relative value resolves inside the
# harvester project root; an absolute value is used verbatim. Ignored if WEBFETCH_DIR is set.
#HARVESTER_CACHE_DIR=.cache

# claude.ai truncates a tool result at ~150,000 characters. Staying under it means the cache file,
# not the transport, holds the overflow.
HARVESTER_MAX_INLINE_CHARS=120000

# Optional web-search backends. Without either, the `search` tool is hidden.
SEARXNG_URL=
BRAVE_API_KEY=
