# Without this, `ADD . /app` copies the venv, the fetch cache, and — critically — a populated
# .env.remote INTO the image layers. Secrets belong in the runtime environment, never in a layer.

# secrets
.env
.env.*
!.env.remote.example
.harvester-state/

# local state that must not become image content
.cache/
.fetch/
tmp/
.venv/

# vcs + tooling
.git/
.gitignore
.github/
.claude/
.professor/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# not needed at runtime
tests/
docs/
*.md
!README.md
compose*.yaml
Dockerfile
.dockerignore

# OS cruft
.DS_Store
Thumbs.db
